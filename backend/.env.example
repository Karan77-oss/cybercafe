# Database Connection (PostgreSQL / Supabase with Prisma)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Storage & Credentials
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="customer-documents"

# JWT Secret & Expiration
JWT_SECRET="your-strong-random-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Server Port & Mode
PORT=4000
NODE_ENV=production

# Primary Admin Setup (Secured via environment)
ADMIN_ID="Karan Kumar"
ADMIN_EMAIL="rajkaran969355@gmail.com"
ADMIN_PASSWORD="YourSecureAdminPassword"
