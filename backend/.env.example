# ========================================================
# RAILWAY DEPLOYMENT ENVIRONMENT VARIABLES (BACKEND)
# Paste these into Railway Dashboard -> Your Service -> Variables
# ========================================================

# Node Environment & Network Binding
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Live Production Supabase PostgreSQL Connection
# Use the connection pooler URL (port 6543) for DATABASE_URL with pgbouncer=true
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Live Production Supabase Storage & Service API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...[YOUR-SUPABASE-SERVICE-ROLE-SECRET-KEY]
SUPABASE_STORAGE_BUCKET=customer-documents

# Security & Authentication
JWT_SECRET=your-strong-production-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Initial Super Admin Bootstrapping (for local Admin login)
ADMIN_ID=Karan Kumar
ADMIN_EMAIL=rajkaran969355@gmail.com
ADMIN_PASSWORD=YourStrongAdminPassword2026!

# Razorpay Production / Test Gateway Credentials
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dynamic CORS Allowed Origins (Comma-separated custom domains + Vercel automatic wildcard)
# Note: *.vercel.app, localhost, and capacitor:// are allowed automatically.
# Add your custom production domains here:
ALLOWED_ORIGINS=https://cybercafe.com,https://worker.cybercafe.com

# Database safety flag (keep false in production so data is strictly persisted to Supabase)
ALLOW_JSON_FALLBACK=false
