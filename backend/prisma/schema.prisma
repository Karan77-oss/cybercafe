generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  password             String
  name                 String
  role                 Role              @default(CUSTOMER)
  phone                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  address              String?
  bankDetails          Json?
  businessName         String?
  city                 String?
  isOnline             Boolean           @default(false)
  lastLoginAt          DateTime?
  profileImage         String?
  status               String            @default("ACTIVE")
  verificationStatus   String?           @default("PENDING")
  verifiedAt           DateTime?
  verifiedBy           String?
  activeOrdersCount    Int               @default(0)
  avgCompletionMinutes Int               @default(60)
  completedOrdersCount Int               @default(0)
  lastHeartbeatAt      DateTime?
  auditLogs            AuditLog[]
  complaints           Complaint[]
  documentsAsCustomer  Document[]        @relation("CustomerDocuments")
  ledgerEntries        FinancialLedger[]
  notifications        Notification[]
  ordersAsCustomer     Order[]           @relation("CustomerOrders")
  ordersAsUser         Order[]           @relation("UserOrders")
  refunds              Refund[]
  reviews              Review[]
  approvedServices     Service[]         @relation("AdminApprovedServices")

  @@index([email])
  @@index([role])
  @@index([status])
}

model Worker {
  id                   String            @id @default(uuid())
  name                 String
  email                String            @unique
  passwordHash         String
  phone                String?
  specialization       String?
  skills               Json?
  status               String            @default("ACTIVE")
  kycStatus            String            @default("VERIFIED")
  walletBalancePaise   Int               @default(0)
  totalEarningsPaise   Int               @default(0)
  isOnline             Boolean           @default(false)
  lastHeartbeatAt      DateTime?
  lastLoginAt          DateTime?
  address              String?
  city                 String?
  businessName         String?
  profileImage         String?
  activeOrdersCount    Int               @default(0)
  avgCompletionMinutes Int               @default(60)
  completedOrdersCount Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  orders               Order[]
  proposals            ServiceProposal[]
  receipts             Receipt[]
  jobs                 Job[]             @relation("WorkerJobs")
  payouts              Payout[]
  workerEarnings       WorkerEarning[]
  ledgerEntries        FinancialLedger[]
  withdrawals          Withdrawal[]
  documents            Document[]        @relation("WorkerDocuments")
  createdServices      Service[]         @relation("WorkerCreatedServices")
  reviews              Review[]

  @@index([email])
  @@index([status])
  @@index([status, isOnline])
}

model Service {
  id                   String            @id @default(uuid())
  name                 String
  description          String
  category             String
  pricePaise           Int
  estimatedTime        String
  requiredDocuments    String[]          @default([])
  formSchema           Json?
  status               ServiceStatus     @default(INACTIVE)
  approvalStatus       ApprovalStatus    @default(PENDING_APPROVAL)
  createdByWorkerId    String?
  approvedByAdminId    String?
  approvedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  adminCommissionPaise Int               @default(0)
  currency             String            @default("INR")
  platformFeePaise     Int               @default(0)
  slug                 String?           @unique
  workerAmountPaise    Int               @default(0)
  is_active            Boolean?          @default(dbgenerated("(status = 'ACTIVE'::\"ServiceStatus\")"))
  applicationTypes     Json?
  applicationTypesList ApplicationType[]
  orders               Order[]
  reviews              Review[]
  approvedByAdmin      User?             @relation("AdminApprovedServices", fields: [approvedByAdminId], references: [id])
  createdByWorker      Worker?           @relation("WorkerCreatedServices", fields: [createdByWorkerId], references: [id])

  @@index([category])
  @@index([status])
}

model ApplicationType {
  id          String   @id @default(uuid())
  serviceId   String
  title       String
  description String?
  badge       String?
  formType    String?
  pricePaise  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceProposal {
  id                         String         @id @default(uuid())
  workerId                   String
  name                       String
  description                String
  category                   String
  suggestedPricePaise        Int
  estimatedTime              String
  requiredDocuments          String[]       @default([])
  formSchema                 Json?
  status                     ApprovalStatus @default(PENDING_APPROVAL)
  adminComment               String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  requestedWorkerAmountPaise Int?
  applicationTypes           Json?
  worker                     Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([status])
}

model Order {
  id                      String            @id @default(uuid())
  customerId              String
  userId                  String?
  serviceId               String
  serviceSnapshot         Json
  pricing                 Json
  status                  OrderStatus       @default(PAYMENT_PENDING)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  acceptedAt              DateTime?
  adminCommissionPaise    Int               @default(0)
  assignedWorkerId        String?
  workerId                String?
  bookingDate             String?
  cancelledAt             DateTime?
  completedAt             DateTime?
  currency                String            @default("INR")
  customerPaidAmountPaise Int               @default(0)
  earningStatus           String            @default("PENDING")
  formData                Json?
  orderNumber             String            @unique @default(cuid())
  paymentStatus           PaymentStatus     @default(PENDING)
  platformFeePaise        Int               @default(0)
  proposedDate            String?
  proposedSlot            String?
  receiptSubmittedAt      DateTime?
  slotStatus              String?           @default("UNASSIGNED")
  startedAt               DateTime?
  timeSlot                String?
  workCompletedAt         DateTime?
  workerAmountPaise       Int               @default(0)
  applicationType         String?
  customerNotes           String?
  paidAt                  DateTime?
  complaints              Complaint[]
  documents               Document[]
  ledgerEntries           FinancialLedger[]
  job                     Job?
  customer                User              @relation("CustomerOrders", fields: [customerId], references: [id])
  user                    User?             @relation("UserOrders", fields: [userId], references: [id])
  worker                  Worker?           @relation(fields: [workerId], references: [id])
  service                 Service           @relation(fields: [serviceId], references: [id])
  payments                Payment[]
  receipts                Receipt[]
  refunds                 Refund[]
  review                  Review?
  workerEarnings          WorkerEarning[]

  @@index([customerId])
  @@index([userId])
  @@index([serviceId])
  @@index([assignedWorkerId])
  @@index([workerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model Job {
  id          String     @id @default(uuid())
  orderId     String     @unique
  workerId    String
  status      JobStatus  @default(ASSIGNED)
  acceptedAt  DateTime   @default(now())
  startedAt   DateTime?
  submittedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  notes       String?
  documents   Document[]
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  worker      Worker     @relation("WorkerJobs", fields: [workerId], references: [id])
  payout      Payout?

  @@index([workerId])
  @@index([status])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  provider          String        @default("RAZORPAY")
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  amountPaise       Int
  status            PaymentStatus @default(PENDING)
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  currency          String        @default("INR")
  paidAt            DateTime?
  signature         String?
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([providerPaymentId])
}

model Payout {
  id          String       @id @default(uuid())
  jobId       String       @unique
  workerId    String
  amountPaise Int
  status      PayoutStatus @default(PENDING)
  releasedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker      Worker       @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@index([status])
}

model WorkerEarning {
  id                 String    @id @default(uuid())
  workerId           String
  orderId            String
  amountPaise        Int
  currency           String    @default("INR")
  status             String    @default("PENDING")
  holdReason         String?
  holdAt             DateTime?
  releasedFromHoldAt DateTime?
  releasedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  worker             Worker    @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model FinancialLedger {
  id             String   @id @default(uuid())
  workerId       String?
  orderId        String?
  withdrawalId   String?
  refundId       String?
  type           String
  amountPaise    Int
  currency       String   @default("INR")
  status         String   @default("COMPLETED")
  reference      String?
  idempotencyKey String   @unique
  metadata       Json?
  createdAt      DateTime @default(now())
  order          Order?   @relation(fields: [orderId], references: [id])
  worker         Worker?  @relation(fields: [workerId], references: [id])
  user           User?    @relation(fields: [userId], references: [id])
  userId         String?

  @@index([workerId])
  @@index([orderId])
  @@index([withdrawalId])
  @@index([type])
  @@index([createdAt])
}

model Withdrawal {
  id               String    @id @default(uuid())
  workerId         String
  amountPaise      Int
  currency         String    @default("INR")
  status           String    @default("REQUESTED")
  method           String    @default("BANK")
  payoutDetails    Json?
  paymentReference String?
  adminNote        String?
  approvedBy       String?
  processedBy      String?
  requestedAt      DateTime  @default(now())
  approvedAt       DateTime?
  processedAt      DateTime?
  completedAt      DateTime?
  rejectedAt       DateTime?
  worker           Worker    @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@index([status])
  @@index([requestedAt])
}

model Receipt {
  id           String    @id @default(uuid())
  orderId      String
  workerId     String
  customerId   String
  storagePath  String
  fileName     String
  mimeType     String?
  sizeBytes    Int?
  status       String    @default("SUBMITTED")
  submittedAt  DateTime  @default(now())
  viewedAt     DateTime?
  downloadedAt DateTime?
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  worker       Worker?   @relation(fields: [workerId], references: [id])

  @@index([orderId])
  @@index([workerId])
  @@index([customerId])
  @@index([status])
}

model Complaint {
  id          String    @id @default(uuid())
  orderId     String
  customerId  String
  workerId    String?
  reason      String
  description String
  status      String    @default("OPEN")
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customer    User      @relation(fields: [customerId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model Refund {
  id               String    @id @default(uuid())
  orderId          String
  paymentId        String?
  customerId       String
  amountPaise      Int
  currency         String    @default("INR")
  reason           String?
  status           String    @default("REQUESTED")
  providerRefundId String?
  approvedBy       String?
  processedBy      String?
  requestedAt      DateTime  @default(now())
  approvedAt       DateTime?
  processedAt      DateTime?
  customer         User      @relation(fields: [customerId], references: [id])
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([requestedAt])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  customerId String
  workerId   String?
  serviceId  String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   User     @relation(fields: [customerId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  worker     Worker?  @relation(fields: [workerId], references: [id])

  @@index([orderId])
  @@index([customerId])
  @@index([workerId])
  @@index([serviceId])
}

model Document {
  id              String    @id @default(uuid())
  orderId         String?
  jobId           String?
  customerId      String
  workerId        String?
  type            String
  fileName        String
  mimeType        String
  size            Int
  storageKey      String    @unique
  createdAt       DateTime  @default(now())
  isPurged        Boolean   @default(false)
  isWorkingCopy   Boolean   @default(true)
  purgeEligibleAt DateTime?
  docName         String?
  name            String?
  url             String?
  customer        User      @relation("CustomerDocuments", fields: [customerId], references: [id])
  job             Job?      @relation(fields: [jobId], references: [id])
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  worker          Worker?   @relation("WorkerDocuments", fields: [workerId], references: [id])

  @@index([orderId])
  @@index([customerId])
  @@index([jobId])
  @@index([purgeEligibleAt, isPurged])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model WelfareCase {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  orderId       String        @map("order_id")
  issueType     String        @map("issue_type")
  description   String
  status        String        @default("open")
  internalNotes Json?         @map("internal_notes")
  isEscalated   Boolean       @default(false) @map("is_escalated")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  refundRecord  RefundRecord?

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("tickets")
}

model RefundRecord {
  id          String      @id @default(uuid())
  ticketId    String      @unique @map("ticket_id")
  orderId     String      @map("order_id")
  amount      Float
  status      String      @default("pending")
  utrNumber   String?     @map("utr_number")
  receiptUrl  String?     @map("receipt_url")
  processedBy String?     @map("processed_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  ticket      WelfareCase @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([orderId])
  @@index([status])
  @@map("refund_records")
}

enum Role {
  CUSTOMER
  WORKER
  ADMIN
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DRAFT
  REJECTED
  SUSPENDED
}

enum ApprovalStatus {
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum OrderStatus {
  PAYMENT_PENDING
  PAID
  AVAILABLE
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  SUBMITTED
  REVISION_REQUIRED
  COMPLETED
  CANCELLED
  DISPUTED
  CREATED
  ACCEPTED
  WORK_COMPLETED
  RECEIPT_SUBMITTED
  REJECTED
  REFUND_PENDING
  REFUNDED
}

enum JobStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
  ACCEPTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PROCESSING
  CANCELLED
  REFUND_PENDING
}

enum PayoutStatus {
  PENDING
  ELIGIBLE
  RELEASED
  FAILED
}
