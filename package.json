{
  "name": "cyber-cafe-marketplace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "admin",
    "worker",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=@cybercafe/frontend",
    "dev:admin": "npm run dev --workspace=@cybercafe/admin",
    "dev:worker": "npm run dev --workspace=@cybercafe/worker",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=@cybercafe/frontend",
    "build:admin": "npm run build --workspace=@cybercafe/admin",
    "build:worker": "npm run build --workspace=@cybercafe/worker",
    "build:backend": "npm run build --workspace=backend",
    "build:all": "npm run build:backend && npm run build:frontend && npm run build:admin && npm run build:worker",
    "test:backend": "npm run test --workspace=backend",
    "start": "npm run start --workspace=backend"
  }
}
