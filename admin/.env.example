# ========================================================
# LOCALHOST ADMIN PORTAL ENVIRONMENT VARIABLES
# Save as `admin/.env.local` to run Admin on localhost with Live Production Data
# Command to run: npm run dev:admin
# ========================================================

# Live Railway Production Backend URL
# Directs all admin operations (order assignments, proposals, universal app types, pricing) to live Railway
VITE_API_URL=https://[YOUR-RAILWAY-SERVICE-NAME].up.railway.app

# Live Supabase Production Configuration (Anon Key)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJh...[YOUR-SUPABASE-ANON-PUBLIC-KEY]

# App Execution Mode
VITE_APP_MODE=admin

# Port configuration (default: 5174)
PORT=5174
