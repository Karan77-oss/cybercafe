# =========================================================================
# CYBER CAFE ENTERPRISE DEPLOYMENT ARCHITECTURE
# 1. Backend Server: Deployed on Railway (connected to live Supabase DB)
# 2. Worker Portal: Deployed on Vercel
# 3. Customer App: Deployed on Vercel
# 4. Admin Portal: Runs on Localhost (connected to live Railway + Supabase)
# =========================================================================

# --- 1. RAILWAY BACKEND (backend/.env) ---
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres.[REF]:[PASS]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[REF]:[PASS]@aws-0-[REGION].pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[SECRET-KEY]
SUPABASE_STORAGE_BUCKET=customer-documents
JWT_SECRET=[SECRET]
ADMIN_ID=Karan Kumar
ADMIN_EMAIL=rajkaran969355@gmail.com
ADMIN_PASSWORD=[PASSWORD]
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
ALLOWED_ORIGINS=https://cybercafe.com,https://worker.cybercafe.com

# --- 2. VERCEL WORKER PORTAL (worker/.env) ---
VITE_API_URL=https://[YOUR-RAILWAY-SERVICE-NAME].up.railway.app
VITE_SUPABASE_URL=https://[REF].supabase.co
VITE_SUPABASE_ANON_KEY=[ANON-KEY]
VITE_APP_MODE=worker

# --- 3. VERCEL CUSTOMER APP (mobile-app/.env) ---
VITE_API_URL=https://[YOUR-RAILWAY-SERVICE-NAME].up.railway.app
VITE_SUPABASE_URL=https://[REF].supabase.co
VITE_SUPABASE_ANON_KEY=[ANON-KEY]
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
VITE_APP_MODE=customer

# --- 4. LOCALHOST ADMIN PORTAL (admin/.env.local) ---
VITE_API_URL=https://[YOUR-RAILWAY-SERVICE-NAME].up.railway.app
VITE_SUPABASE_URL=https://[REF].supabase.co
VITE_SUPABASE_ANON_KEY=[ANON-KEY]
VITE_APP_MODE=admin
