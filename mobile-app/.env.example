# ========================================================
# VERCEL DEPLOYMENT ENVIRONMENT VARIABLES (CUSTOMER APP)
# Paste these into Vercel Dashboard -> Customer Project -> Settings -> Environment Variables
# ========================================================

# Live Railway Backend URL (Point to your deployed Railway backend)
VITE_API_URL=https://[YOUR-RAILWAY-SERVICE-NAME].up.railway.app

# Live Supabase Production Configuration (Anon Key ONLY)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJh...[YOUR-SUPABASE-ANON-PUBLIC-KEY]

# Razorpay Key ID (Public Client Key)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# App Execution Mode
VITE_APP_MODE=customer
